{
  "name": "aiagentassistant",
  "version": "1.0.0",
  "description": "AI Agent Assistant - A lightweight multi-agent orchestration system with Telegram integration",
  "main": "dist/index.js",
  "author": {
    "name": "Jose Rodriguez Arroyo",
    "email": "jrpcone@gmail.com",
    "url": "https://github.com/jorodriguezpr/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jorodriguezpr/AiAgentAssistant"
  },
  "bin": {
    "aitalk": "dist/cli/aitalk.js"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/knowledge', {recursive: true}); require('fs').copyFileSync('src/knowledge/action-patterns.json', 'dist/knowledge/action-patterns.json')\"",
    "start": "node dist/index.js",
    "aitalk": "node dist/cli/aitalk.js",
    "aitalk:dev": "ts-node src/cli/aitalk.ts",
    "docker:build": "docker build -t aiagentassistant .",
    "docker:run": "docker run --env-file .env -p 3000:3000 aiagentassistant"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.6.2",
    "bull": "^4.14.1",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "html2pdf.js": "^0.10.1",
    "imap": "^0.8.19",
    "js-yaml": "^4.1.1",
    "mailparser": "^3.6.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.13.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "redis": "^4.6.13",
    "telegraf": "^4.14.0",
    "uuid": "^9.0.0",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.12.11",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
