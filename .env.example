# Multi-Agent Orchestrator System Configuration

# ============================================
# Core Configuration
# ============================================

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Server Configuration
API_PORT=3000
API_HOST=0.0.0.0

# System Configuration
LOG_LEVEL=info
NODE_ENV=development

# ============================================
# Chat Platform Gateways
# ============================================

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=http://localhost:3000/telegram
TELEGRAM_WEBHOOK_PORT=3000

# WhatsApp Configuration (optional)
ENABLE_WHATSAPP=false
WHATSAPP_SESSION_NAME=aiagentassistant

# Discord Configuration (optional)
ENABLE_DISCORD=false
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_COMMAND_PREFIX=!
DISCORD_STATUS=AI Agent Assistant | !help

# ============================================
# AI Provider Configuration
# ============================================

# AI Provider Configuration
# Primary: Anthropic Claude (recommended for accuracy and reasoning)
# Alternatives: github-copilot, openai, gemini, ollama, lemonade
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_API_KEY=your_anthropic_api_key_here

# Optional: GitHub Copilot or OpenAI fallback
# GITHUB_COPILOT_API_KEY=your_github_pat_token_here
# OPENAI_API_KEY=your_openai_api_key_here

# Ollama Local LLM Configuration (optional)
# To use Ollama, set AI_PROVIDER=ollama and configure the following:
# OLLAMA_BASE_URL=http://172.27.112.1:11434
# AI_MODEL=qwen2.5-coder:latest
# Note: No API key needed for local Ollama instances

# Lemonade Local LLM Server Configuration (optional)
# Lemonade is an OpenAI-compatible local LLM server
# To use Lemonade, set AI_PROVIDER=lemonade and configure the following:
# LEMONADE_BASE_URL=http://localhost:8000
# AI_MODEL=Qwen2.5-0.5B-Instruct-CPU
# Note: No API key needed for local Lemonade instances

# Ollama Cloud Configuration (optional)
# Hosted Ollama service at ollama.com — same wire format as local Ollama, Bearer auth
# To use Ollama Cloud, set AI_PROVIDER=ollama-cloud and configure the following:
# OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key_here
# AI_MODEL=nemotron-3-super
# Available models: nemotron-3-super, llama3.3, gemma3, phi4, mistral, deepseek-r1, etc.
# OLLAMA_CLOUD_BASE_URL=https://ollama.com  (optional override, this is the default)

# AI Model Selection (optional - provider defaults will be used if not set)
#
# Anthropic Claude (2026) - RECOMMENDED:
#   - claude-opus-4-7: Most capable model (complex reasoning, agents, IT tasks) ★ DEFAULT ★
#   - claude-sonnet-4-6: Best speed/intelligence balance ($3 input, $15 output)
#   - claude-haiku-4-5: Fastest & most cost-efficient ($1 input, $5 output)
#   - claude-opus-4-6: Previous generation (still available)
#
# GitHub Models 2026:
#   - gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-3.5-turbo
#
# OpenAI:
#   - gpt-4-turbo, gpt-4, gpt-3.5-turbo
#
# Google Gemini:
#   - gemini-pro, gemini-pro-vision
#
# Ollama Local Models:
#   - qwen2.5-coder:latest, llama3:latest, mistral:latest, codellama:latest
#   - Or any model you have pulled in Ollama
#
# Lemonade Local Models:
#   - Qwen2.5-0.5B-Instruct-CPU, or any model available on your Lemonade server
#
AI_MODEL=claude-opus-4-7

# AI Configuration
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# ============================================
# Agent Configuration
# ============================================

# Agent Configuration
ORCHESTRATOR_ID=master-orchestrator
ORCHESTRATOR_NAME=Master Orchestrator
WORKER_AGENTS_COUNT=3
MAX_CONCURRENT_TASKS=10

# ============================================
# Feature Flags
# ============================================

# Enable specific features
ENABLE_WEB_SEARCH=true
ENABLE_EMAIL=true
ENABLE_PDF_GENERATION=true
ENABLE_SCHEDULING=true

# ============================================
# Notes
# ============================================

# Platform Setup:
# - Telegram: Get token from @BotFather on Telegram
# - WhatsApp: Set ENABLE_WHATSAPP=true and scan QR code on first run
# - Discord: Create bot at https://discord.com/developers and enable MESSAGE CONTENT INTENT
# 
# Security:
# - Never commit .env file to version control
# - Use keyring for production credentials
# - Keep bot tokens secret
#
# More info: See MULTIPLATFORM_SETUP.md and QUICKSTART_MULTIPLATFORM.md
